page { background: #F7F5F0; color: #22352F; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 36rpx 32rpx 150rpx; }
.eyebrow { color: #678278; font-size: 22rpx; letter-spacing: 3rpx; font-weight: 600; }
.title { font-size: 54rpx; line-height: 1.2; font-weight: 700; margin: 10rpx 0 16rpx; }
.subtitle { color: #708078; font-size: 27rpx; line-height: 1.6; }
.card { background: #FFFFFF; border-radius: 28rpx; padding: 30rpx; box-shadow: 0 8rpx 30rpx rgba(34,53,47,.045); }
.section-title { font-size: 32rpx; font-weight: 700; margin: 40rpx 0 20rpx; }
.muted { color: #829088; }
.primary-btn { background: #255D4A; color: #FFFFFF; border-radius: 999rpx; font-weight: 600; font-size: 30rpx; line-height: 2.8; }
.primary-btn::after, .secondary-btn::after { border: 0; }
.secondary-btn { background: #E7EEE9; color: #255D4A; border-radius: 999rpx; font-size: 28rpx; line-height: 2.8; }
.bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-around; height: 116rpx; padding-bottom: env(safe-area-inset-bottom); background: rgba(255,255,255,.97); border-top: 1rpx solid #E6E9E3; z-index: 10; }
.nav-item { width: 25%; text-align: center; color: #8A9B91; font-size: 23rpx; }
.nav-item.active { color: #255D4A; font-weight: 700; }
.nav-icon { font-size: 38rpx; line-height: 1.3; display: block; }
.pill { display: inline-block; padding: 9rpx 20rpx; border-radius: 999rpx; color: #3B6856; background: #EDF3EE; font-size: 23rpx; }
.empty { text-align: center; padding: 70rpx 30rpx; color: #829088; line-height: 1.8; }
.empty-icon { display: block; font-size: 70rpx; margin-bottom: 16rpx; }
