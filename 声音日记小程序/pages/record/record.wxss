.recorder { margin-top: 42rpx; text-align: center; padding: 42rpx 28rpx 34rpx; }
.wave-wrap { height: 150rpx; display: flex; align-items: center; justify-content: center; }
.wave { width: 610rpx; height: 128rpx; }
.timer { font-size: 70rpx; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 3rpx; margin: 22rpx 0 4rpx; }
.record-state { color: #7F9085; font-size: 25rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #B6C5B9; }
.status-dot.live { background: #DB6557; box-shadow: 0 0 0 8rpx #F8E2DF; }
.record-actions { margin-top: 42rpx; }
.record-actions button { margin: 0; }
.split { display: flex; gap: 16rpx; }
.split button { flex: 1; }
.waiting { padding: 38rpx 0 0; }
.hint { font-size: 22rpx; color: #A4AEA7; margin-top: 28rpx; }
.editor .section-title { margin-top: 44rpx; }
.preview { margin-bottom: 20rpx; padding-bottom: 18rpx; }
.preview-row { display: flex; align-items: center; }
.play-icon { background: #255D4A; color: white; width: 74rpx; height: 74rpx; line-height: 74rpx; text-align: center; border-radius: 50%; font-size: 30rpx; }
.preview-label { flex: 1; text-align: left; margin-left: 20rpx; font-weight: 700; }
.preview-time { color: #8E9C91; font-size: 23rpx; font-weight: 400; margin-top: 6rpx; }
.replay { color: #39765C; font-size: 25rpx; }
.form { padding: 32rpx; }
.field-label { font-weight: 600; font-size: 27rpx; margin: 24rpx 0 12rpx; }
.field-label:first-child { margin-top: 0; }
.required { color: #CF6C5D; }
.field-input, .field-textarea, .field-select { box-sizing: border-box; width: 100%; background: #F6F8F5; border-radius: 16rpx; padding: 22rpx 20rpx; font-size: 27rpx; }
.field-input { height: 84rpx; }
.field-textarea { height: 180rpx; }
.field-select { display: flex; justify-content: space-between; }
.save-btn { margin: 28rpx 0 10rpx; }
